{
    "schemaVersion": 1,
    "id": "authcmd",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "https://www.curseforge.com/minecraft/mc-mods/authcmd",
        "issues": "https://github.com/Huziyang520/AuthCmd/issues"
    },
    "license": "${license}",
    "icon": "assets/authcmd/textures/authcmd.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.authcmd.mod.AuthCmdMod"
        ],
        "client": [
            "com.authcmd.mod.client.AuthCmdClient"
        ],
        "modmenu": [
            "com.authcmd.mod.client.ModMenuConfigEntry"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=0.19.3",
        "fabric-api": "*",
        "minecraft": ">=26.1 <26.3",
        "java": ">=25"
    },
    "suggests": {
        "avalonbase": ">=1.0.0"
    },
    "custom": {
        "catalogue": {
            "configFactory": "com.authcmd.mod.client.CatalogueConfigEntry"
        }
    }
}